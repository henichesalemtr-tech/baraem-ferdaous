# ══════════════════════════════════════════════════════════════════
#  منصة الفردوس — Local Development Environment
#  Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════

# ── PostgreSQL Database ────────────────────────────────────────────
# Local example: postgresql://postgres:password@localhost:5432/ferdous
# Or use a hosted DB (Supabase / Neon / Railway)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ferdous

# ── App Secret (used for JWT/session signing) ─────────────────────
# Generate a strong random string:  openssl rand -hex 32
AUTH_SECRET=change_this_to_a_random_32_char_secret_string

# ── Web Push Notifications (optional) ────────────────────────────
# Generate VAPID keys:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Unused / Platform-specific (leave as-is for local) ───────────
BTY_LLM_SERVER_API_KEY=
HAPPYSEEDS_KEY=
HAPPYSEEDS_PROJECT_ID=local
HAPPYSEEDS_AVAILABLE_MODELS=
LLM_API_KEY=
LLM_BASE_URL=
LOG_DIR=./logs
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NOVA_ACCESS_KEY=
NOVA_BASE_URL=
NOVA_TENANT_ID=
REACTUS_BASE_URL=
REACTUS_ENV=dev
REACTUS_PROJECT_ID=local
